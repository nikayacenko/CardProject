<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CardProject" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#508379C5</item>
        <item name="colorPrimaryVariant">#504C36F4</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Для Material Components -->
<!-- верхняя часть (нижняя и статус бар в colors-->
        <item name="colorPrimarySurface">@color/your_primary_color</item>
    </style>
    <style name="TextAppearance_Material3_Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="RoundedDialogTheme" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="dialogCornerRadius">16dp</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="Theme.CardProject" parent="Base.Theme.CardProject" />

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">#C2B9F8</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Стиль для контурной кнопки -->
    <style name="Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">#C2B9F8</item>
        <item name="android:textColor">@color/button_outline</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Стиль для неактивной кнопки -->
    <style name="Button.Disabled" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_disabled</item>
        <item name="android:textColor">@color/button_disabled_text</item>
    </style>
    <style name="BrightButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">#FF6200EE</item>
        <item name="android:textColor">@color/white</item>
    </style>


    <!-- ============================================================ -->
    <!-- ФИОЛЕТОВАЯ ТЕМА                                               -->
    <!-- ============================================================ -->
    <style name="Theme.CardProject.Purple" parent="Theme.CardProject">
        <item name="colorPrimary">#AE99FA</item>
        <item name="colorPrimaryVariant">#AE99FA</item>  <!-- ← ОДИНАКОВЫЙ ЦВЕТ -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimarySurface">#AE99FA</item>

        <!-- 🔥 ЯВНО ЗАДАЁМ СТАТУС-БАР И НАВБАР -->
        <item name="android:statusBarColor">#AE99FA</item>
        <item name="android:navigationBarColor">#AE99FA</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ============================================================ -->
    <!-- СИНЯЯ ТЕМА                                                    -->
    <!-- ============================================================ -->
    <style name="Theme.CardProject.Blue" parent="Theme.CardProject">
        <item name="colorPrimary">#A6BFF6</item>
        <item name="colorPrimaryVariant">#A6BFF6</item>  <!-- ← ОДИНАКОВЫЙ ЦВЕТ -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimarySurface">#A6BFF6</item>

        <item name="android:statusBarColor">#A6BFF6</item>
        <item name="android:navigationBarColor">#A6BFF6</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ============================================================ -->
    <!-- ЗЕЛЁНАЯ ТЕМА                                                  -->
    <!-- ============================================================ -->
    <style name="Theme.CardProject.Green" parent="Theme.CardProject">
        <item name="colorPrimary">#9CEBC4</item>
        <item name="colorPrimaryVariant">#9CEBC4</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimarySurface">#9CEBC4</item>

        <item name="android:statusBarColor">#9CEBC4</item>
        <item name="android:navigationBarColor">#9CEBC4</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ============================================================ -->
    <!-- ОРАНЖЕВАЯ ТЕМА                                                -->
    <!-- ============================================================ -->
    <style name="Theme.CardProject.Orange" parent="Theme.CardProject">
        <item name="colorPrimary">#FB6334</item>
        <item name="colorPrimaryVariant">#FB6334</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimarySurface">#FB6334</item>

        <item name="android:statusBarColor">#FB6334</item>
        <item name="android:navigationBarColor">#FB6334</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ============================================================ -->
    <!-- РОЗОВАЯ ТЕМА                                                  -->
    <!-- ============================================================ -->
    <style name="Theme.CardProject.Pink" parent="Theme.CardProject">
        <item name="colorPrimary">#FF6A83</item>
        <item name="colorPrimaryVariant">#FD5A6F</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimarySurface">#FF6A83</item>

        <item name="android:statusBarColor">#FF6A83</item>
        <item name="android:navigationBarColor">#FF6A83</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>